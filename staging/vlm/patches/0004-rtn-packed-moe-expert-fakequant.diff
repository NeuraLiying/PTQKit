+# Packed MoE expert Parameters (Qwen3-VL-MoE / similar): shape (E, out, in).
+# Fake-quant along the last (input) dim — same axis as nn.Linear.weight.
+_PACKED_EXPERT_PARAM_NAMES = ("gate_up_proj", "down_proj")
+
+
+def get_named_moe_expert_params(module):
+    """Return 3D packed expert weight Parameters under a decoder layer / MoE block.
+
+    Skips router (TopKRouter.weight) which should stay high precision.
+    """
+    out = {}
+    for name, p in module.named_parameters():
+        leaf = name.rsplit(".", 1)[-1]
+        if leaf in _PACKED_EXPERT_PARAM_NAMES and p.ndim == 3:
+            out[name] = p
+    return out
+
+
+def llm_quant_coverage_stats(model, exclude_substrings=None):
+    """Estimate LLM weight coverage for Qwen3-VL-MoE.
+
+    Counts numel of language_model parameters excluding embeddings, lm_head, and
+    router weights. "Covered" target = Attn nn.Linear weights + packed expert Parameters.
+    """
+    if exclude_substrings is None:
+        exclude_substrings = (
+            "embed_tokens",
+            "lm_head",
+            "visual",
+            ".gate.weight",  # TopKRouter
+            "mtp",
+        )
+    root = model
+    if hasattr(model, "model") and hasattr(model.model, "language_model"):
+        root = model.model.language_model
+    elif hasattr(model, "language_model"):
+        root = model.language_model
+
+    total = 0
+    covered = 0
+    skipped = 0
+    details = {"linears": 0, "experts": 0, "other": 0, "excluded": 0}
+    for name, p in root.named_parameters():
+        n = p.numel()
+        if any(s in name for s in exclude_substrings):
+            details["excluded"] += n
+            skipped += n
+            continue
+        total += n
+        leaf = name.rsplit(".", 1)[-1]
+        is_attn_linear = leaf == "weight" and p.ndim == 2 and (
+            "self_attn." in name
+            or name.endswith(".q_proj.weight")
+            or name.endswith(".k_proj.weight")
+            or name.endswith(".v_proj.weight")
+            or name.endswith(".o_proj.weight")
+        )
+        if is_attn_linear:
+            covered += n
+            details["linears"] += n
+        elif leaf in _PACKED_EXPERT_PARAM_NAMES and p.ndim == 3:
+            covered += n
+            details["experts"] += n
+        else:
+            details["other"] += n
+    ratio = (covered / total) if total else 0.0
+    return {
+        "eligible_numel": total,
+        "covered_numel": covered,
+        "excluded_numel": skipped,
+        "coverage": ratio,
+        "details": details,
+    }
+
+
